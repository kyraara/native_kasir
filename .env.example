# Database MySQL (Laragon default: root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=native_motor

# Login pemilik toko
OWNER_PASSWORD=ganti-password-ini
# String acak panjang untuk menandatangani token login
AUTH_SECRET=ganti-dengan-string-acak

# Gemini (opsional, untuk Cari Pakai Foto)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Model Gemini (opsional)
# GEMINI_MODEL=gemini-3.8-flash

# Zona waktu toko untuk laporan harian (WIB = +07:00, WITA = +08:00, WIT = +09:00)
STORE_TZ_OFFSET=+07:00
STORE_TZ=Asia/Jakarta

PORT=3000

# Kemiripan foto lokal (butuh ±1 GB RAM). Shared hosting: false
VISION_ENABLED=true

# Izinkan tombol "Reset ke Data Contoh" di server produksi (sebaiknya biarkan false)
ALLOW_DEMO_RESET=false
